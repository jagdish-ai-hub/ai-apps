---
// Page shell for a single tool: hero, the tool itself (slot), steps, explanation, FAQ, its own guide and related tools.
// Emits WebApplication, BreadcrumbList, FAQPage and HowTo JSON-LD. Every tool gets its own URL, title, description and guide.
import Base from '../layouts/Base.astro';
import Ad from './Ad.astro';
import { findTool, toolPath, tools } from '../lib/tools';
import { findGuide, guidePath } from '../lib/guides';
import { absolute, site, langByCode } from '../lib/i18n';
import { LANDING_SLUG, landingAlternates } from '../lib/landings';

interface Props {
  slug: string;
  title: string;
  description: string;
  h1: string;
  lead: string;
  eyebrow?: string;
  steps: string[];
  sections: { h2: string; paras: string[] }[];
  faq: { q: string; a: string }[];
  related?: string[];
  shareText?: string;
  category?: string;
}
const { slug, title, description, h1, lead, eyebrow = '~/convert · runs in your browser', steps, sections, faq, related = [], shareText, category = 'UtilitiesApplication' } = Astro.props;
const tool = findTool(slug)!;
const url = absolute(toolPath(slug));
const guide = tool.guide ? findGuide(tool.guide) : undefined;
// Pages that also exist in other languages declare reciprocal hreflang.
const alternates = slug === LANDING_SLUG ? landingAlternates(absolute, (l) => langByCode(l).hreflang) : [];
const relatedTools = related.map(findTool).filter(Boolean) as typeof tools;

const jsonld = [
  { '@context': 'https://schema.org', '@type': 'WebApplication', name: `${site.siteName} ${tool.name}`, url, description, applicationCategory: category, operatingSystem: 'Any', browserRequirements: 'Requires JavaScript', inLanguage: 'en', isAccessibleForFree: true, offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: absolute('/') },
    { '@type': 'ListItem', position: 2, name: 'Tools', item: absolute('/tools/') },
    { '@type': 'ListItem', position: 3, name: tool.name, item: url },
  ] },
  { '@context': 'https://schema.org', '@type': 'HowTo', name: h1, description, totalTime: 'PT1M', tool: [{ '@type': 'HowToTool', name: `${site.siteName} ${tool.name}` }],
    step: steps.map((s, i) => ({ '@type': 'HowToStep', position: i + 1, text: s.replace(/<[^>]+>/g, '') })) },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<Base title={title} description={description} page={toolPath(slug)} alternates={alternates.length > 1 ? alternates : []} section="tools" jsonld={jsonld} shareText={shareText ?? description}>
  <div class="hero">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/tools/">Tools</a> / {tool.name}</nav>
      <span class="eyebrow">{eyebrow}</span>
      <h1>{h1}</h1>
      <p>{lead}</p>
    </div>
  </div>

  <div class="wrap">
    <slot />
    <Ad slot="afterTool" />

    <section class="block" aria-labelledby="how">
      <span class="eyebrow">01</span>
      <h2 id="how">How to use it</h2>
      <ol class="steps">{steps.map((s) => <li><span set:html={s} /></li>)}</ol>
    </section>

    {guide && (
      <div class="cta">
        <p><strong>Read the guide</strong>{guide.meta.description}</p>
        <a class="btn" href={guidePath(guide.slug)}>{guide.meta.h1}</a>
      </div>
    )}

    {sections.map((s, i) => (
      <>
        <section class="block prose" aria-labelledby={`s${i}`}>
          <span class="eyebrow">{String(i + 2).padStart(2, '0')}</span>
          <h2 id={`s${i}`}>{s.h2}</h2>
          {s.paras.map((p) => <p set:html={p} />)}
        </section>
        {i === 0 && <Ad slot="inContent" />}
      </>
    ))}

    <section class="block faq" aria-labelledby="faq">
      <span class="eyebrow">FAQ</span>
      <h2 id="faq">Frequently asked questions</h2>
      {faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
    </section>

    {relatedTools.length > 0 && (
      <section class="block" aria-labelledby="more-tools">
        <span class="eyebrow">More tools</span>
        <h2 id="more-tools">Related tools</h2>
        <div class="cards">
          {relatedTools.map((t) => (
            <a class="card" href={toolPath(t.slug)}><strong>{t.name}</strong><span>{t.short}</span></a>
          ))}
        </div>
      </section>
    )}
    <Ad slot="beforeFooter" />
  </div>
</Base>
