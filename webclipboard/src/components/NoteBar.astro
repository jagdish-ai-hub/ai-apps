---
// The notes formatting toolbar (one row; it scrolls sideways on narrow screens) with Undo/Redo and the Edit/Preview switch.
// Labels come from the notes JSON ("ui"). Icons are inline SVG so they stay crisp at any size.
interface Props { ui: Record<string, any>; id: string }
const { ui, id } = Astro.props;
const icon = {
  bullet: '<svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><g fill="currentColor"><circle cx="4" cy="5" r="1.4"/><circle cx="4" cy="10" r="1.4"/><circle cx="4" cy="15" r="1.4"/></g><path d="M8 5h9M8 10h9M8 15h9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" fill="none"/></svg>',
  number: '<svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M3 3.5h1.5v4M3 7.5h3M2.8 12.2c.4-.6 1-.9 1.6-.9.8 0 1.4.5 1.4 1.2 0 1.1-1.6 1.6-3 3.4h3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" fill="none"/><path d="M9 5.5h8.5M9 14.5h8.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" fill="none"/></svg>',
  check: '<svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="2.5" width="6" height="6" rx="1.4" stroke-width="1.5"/><path d="M3.9 5.6l1.3 1.3 2.2-2.4" stroke-width="1.5"/><rect x="2.5" y="11.5" width="6" height="6" rx="1.4" stroke-width="1.5"/><path d="M11 5.5h6.5M11 14.5h6.5" stroke-width="1.8"/></svg>',
  undo: '<svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M7 4L3 8l4 4"/><path d="M3 8h9a5 5 0 0 1 0 10H9"/></svg>',
  redo: '<svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M13 4l4 4-4 4"/><path d="M17 8H8a5 5 0 0 0 0 10h3"/></svg>',
};
const buttons = [
  { fmt: 'bold', label: ui.bold, text: 'B', cls: 'b' },
  { fmt: 'italic', label: ui.italic, text: 'I', cls: 'i' },
  { fmt: 'h1', label: ui.title, text: 'H1', cls: 'h' },
  { fmt: 'h2', label: ui.heading, text: 'H2', cls: 'h' },
  { fmt: 'bullet', label: ui.bullets, svg: icon.bullet },
  { fmt: 'number', label: ui.numbered, svg: icon.number },
  { fmt: 'check', label: ui.checklist, svg: icon.check },
];
---
<div class="note-tools">
  <div class="note-bar" id={`${id}-bar`} role="toolbar" aria-label={ui.toolbar}>
    {buttons.map((b) => b.svg
      ? <button type="button" class="nb" data-fmt={b.fmt} aria-label={b.label} title={b.label} set:html={b.svg} />
      : <button type="button" class={`nb ${b.cls}`} data-fmt={b.fmt} aria-label={b.label} title={b.label}>{b.text}</button>)}
    <span class="nb-sep" aria-hidden="true"></span>
    <button type="button" class="nb" data-act="undo" aria-label={ui.undo} title={ui.undo} set:html={icon.undo} />
    <button type="button" class="nb" data-act="redo" aria-label={ui.redo} title={ui.redo} set:html={icon.redo} />
  </div>
  <button class="nb nb-view" id={`${id}-view`} type="button" aria-pressed="false">{ui.preview}</button>
</div>
