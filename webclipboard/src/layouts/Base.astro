---
import '../styles/global.css';
import ShareWidget from '../components/ShareWidget.astro';
import { detectLanguage } from '../lib/langmatch.js';
import { languages, site, messages, localePath, absolute, langByCode } from '../lib/i18n';

interface Props {
  lang?: string;
  title: string;
  description: string;
  /** Page path without language prefix, e.g. "/" or "/privacy/" */
  page?: string;
  /** Emit hreflang alternates for every language (only for pages that exist in all of them) */
  translated?: boolean;
  noindex?: boolean;
  jsonld?: object[];
  /** Highlights the matching nav item */
  section?: 'tokens' | 'guides';
  /** Text offered with the Share button (defaults to the clipboard tagline in the page language) */
  shareText?: string;
}
const { lang = 'en', title, description, page = '/', translated = false, noindex = false, jsonld = [], section, shareText } = Astro.props;
const m = messages(lang);
const meta = langByCode(lang);
const canonical = absolute(translated ? localePath(lang, page) : page);
const ogImage = absolute('/og.png');
const ogImageAlt = 'WebClipboard: copy text on one device and paste it on another with a 6-digit code';
const rtl = false;
const codes = languages.map((l) => l.code);
// First-visit language redirect: only on the English homepage ("/"), inlined in <head> so it runs before first paint.
// Explicit choices (language menu, footer, banner) are saved in localStorage ("wc-lang") and always win over the browser setting.
// Crawlers do not send a non-English language preference, so they keep seeing the English page. If storage is blocked we
// do not redirect at all, because a choice (e.g. staying on English) could not be remembered and would loop.
const redirectScript = lang === 'en' && page === '/' && translated
  ? `(function(){try{if(location.pathname!=='/')return;try{localStorage.setItem('wc-t','1');localStorage.removeItem('wc-t')}catch(e){return}var codes=${JSON.stringify(codes)};var detect=${detectLanguage.toString()};var pref=null;try{pref=localStorage.getItem('wc-lang')}catch(e){}var t=pref&&codes.indexOf(pref)>-1?pref:detect(navigator.languages&&navigator.languages.length?navigator.languages:[navigator.language||'en'],codes);if(t&&t!=='en'){try{sessionStorage.setItem('wc-auto',t+':'+(pref?'saved':'browser'))}catch(e){}location.replace('/'+t+'/'+location.search+location.hash)}}catch(e){}})();`
  : '';
// Share the tool's own address; legal and error pages share the language home page instead.
const shareUrl = ['/about/', '/privacy/', '/terms/', '/contact/', '/404/'].includes(page) ? absolute(localePath(lang)) : canonical;
---
<!doctype html>
<html lang={meta.htmlLang} dir={rtl ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {redirectScript && <script is:inline set:html={redirectScript} />}
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {!noindex && <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}
    {translated && languages.map((l) => <link rel="alternate" hreflang={l.hreflang} href={absolute(localePath(l.code, page))} />)}
    {translated && <link rel="alternate" hreflang="x-default" href={absolute(page)} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content={meta.ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <meta name="theme-color" content="#f2f1ed" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#030604" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    {site.adsense.client && <meta name="google-adsense-account" content={site.adsense.client} />}
    {site.bingSiteVerification && <meta name="msvalidate.01" content={site.bingSiteVerification} />}

    <!-- Set the theme before first paint to avoid a flash -->
    <script is:inline>
      (function () {
        var t;
        try { t = localStorage.getItem('wc-theme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
      })();
    </script>
    {jsonld.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={translated ? localePath(lang) : '/'} aria-label={site.siteName}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="5" y="4" width="14" height="17" rx="2.5" />
            <path d="M9 4V3h6v1" />
            <path d="M9 11l-2 2 2 2M15 11l2 2-2 2" />
          </svg>
          <span>webclipboard<b>.online</b></span>
        </a>
        <nav class="main-nav" aria-label="Main">
          <a href="/token-calculator/" aria-current={section === 'tokens' ? 'page' : undefined}>Token Calculator</a>
          {lang === 'en' && <a href="/guides/" aria-current={section === 'guides' ? 'page' : undefined}>Guides</a>}
        </nav>
        <div class="header-tools">
          <label class="sr-only" for="lang-switch">{m.language}</label>
          <select class="select" id="lang-switch" aria-label={m.language}>
            {languages.map((l) => (
              <option value={l.code === lang ? page : localePath(l.code, translated ? page : '/')} data-code={l.code} selected={l.code === lang}>{l.name}</option>
            ))}
          </select>
          <button class="icon-btn" id="theme-toggle" type="button" aria-label="Toggle light / dark theme">
            <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
            <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
          </button>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <ul class="langs" aria-label={m.language}>
          {languages.map((l) => (
            <li><a href={localePath(l.code)} hreflang={l.hreflang} lang={l.htmlLang} data-code={l.code} aria-current={l.code === lang ? 'true' : undefined}>{l.name}</a></li>
          ))}
        </ul>
        <div class="foot-row">
          <nav class="foot-links" aria-label="Legal">
            {lang === 'en' && <a href="/guides/">Guides</a>}
            <a href="/about/">{m.footerAbout}</a>
            <a href="/privacy/">{m.footerPrivacy}</a>
            <a href="/terms/">{m.footerTerms}</a>
            <a href="/contact/">{m.footerContact}</a>
            {site.adsense.client && <button type="button" id="privacy-settings">{m.footerCookies}</button>}
          </nav>
          <span>© {new Date().getFullYear()} {site.domain} · {m.rights}</span>
        </div>
      </div>
    </footer>

    <aside class="lang-banner" id="lang-banner" role="region" aria-label={m.language} hidden>
      <p id="lang-banner-text"></p>
      <a class="btn small" id="lang-banner-go" href="/"></a>
      <button class="icon-btn" id="lang-banner-close" type="button" aria-label={m.shareClose}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
    </aside>
    <script type="application/json" id="lang-config" set:html={JSON.stringify({ current: lang, codes })} />

    <ShareWidget lang={lang} url={shareUrl} title={title} text={shareText ?? m.shareText} />

    <script>
      const root = document.documentElement;
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('wc-theme', next); } catch {}
      });
      const rememberLang = (code?: string) => {
        if (code) try { localStorage.setItem('wc-lang', code); } catch {}
      };
      document.getElementById('lang-switch')?.addEventListener('change', (e) => {
        const target = e.target as HTMLSelectElement;
        rememberLang(target.selectedOptions[0]?.dataset.code);
        location.href = target.value + location.hash;
      });
      document.querySelectorAll<HTMLAnchorElement>('.langs a[data-code]').forEach((a) =>
        a.addEventListener('click', () => rememberLang(a.dataset.code)),
      );
      document.getElementById('privacy-settings')?.addEventListener('click', () => {
        const w = window as any;
        w.googlefc = w.googlefc || {};
        w.googlefc.callbackQueue = w.googlefc.callbackQueue || [];
        w.googlefc.callbackQueue.push({ CONSENT_DATA_READY: () => w.googlefc.showRevocationMessage?.() });
        w.googlefc.showRevocationMessage?.();
      });
    </script>
    <script>
      import '../scripts/langprefs';
    </script>
    {site.cloudflareAnalyticsToken && (
      <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: site.cloudflareAnalyticsToken })}></script>
    )}
    {site.gtagId && (
      <script is:inline define:vars={{ id: site.gtagId }}>
        window.addEventListener('load', function () {
          setTimeout(function () {
            var s = document.createElement('script');
            s.async = true;
            s.src = 'https://www.googletagmanager.com/gtag/js?id=' + id;
            document.head.appendChild(s);
            window.dataLayer = window.dataLayer || [];
            window.gtag = function () { dataLayer.push(arguments); };
            gtag('js', new Date());
            gtag('config', id);
          }, 2000);
        });
      </script>
    )}
  </body>
</html>
