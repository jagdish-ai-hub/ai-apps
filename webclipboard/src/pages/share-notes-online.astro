---
import ToolPage from '../components/ToolPage.astro';
import Tool from '../components/Tool.astro';
import { notesContent, notesPath } from '../lib/notespages';

const c = notesContent.en;
const p = c.pages.share;
---
<ToolPage
  slug={p.slug}
  title={p.title}
  description={p.description}
  h1={p.h1}
  lead={p.lead}
  eyebrow={p.eyebrow}
  steps={p.steps}
  sections={p.sections}
  faq={p.faq}
  related={['online-notepad', 'iphone-to-windows-clipboard', 'code-share', 'markdown-to-pdf']}
  shareText={p.description}
>
  <Tool lang="en" note={c.ui} />
</ToolPage>
