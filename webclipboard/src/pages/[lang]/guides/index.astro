---
import Base from '../../../layouts/Base.astro';
import { guidesFor, guidePath, guidesHubPath, nativeGuideLangs } from '../../../lib/guides';
import { guideLabels } from '../../../lib/guidelangs.js';
import { absolute, localePath } from '../../../lib/i18n';

export function getStaticPaths() {
  return nativeGuideLangs.map((lang) => ({ params: { lang }, props: { lang } }));
}
const { lang } = Astro.props;
const L = guideLabels[lang];
const guides = guidesFor(lang);
const categories = [...new Set(guides.map((g) => g.meta.category))];
const jsonld = [
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: L.home, item: absolute(localePath(lang)) },
    { '@type': 'ListItem', position: 2, name: L.hubTitle, item: absolute(guidesHubPath(lang)) },
  ] },
];
---
<Base lang={lang} title={L.hubMetaTitle} description={L.hubMetaDesc} page={guidesHubPath(lang)} jsonld={jsonld} section="guides">
  <div class="hero guide-hero">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb"><a href={localePath(lang)}>{L.home}</a> / {L.hubTitle}</nav>
      <span class="eyebrow">{L.hubTitle}</span>
      <h1>{L.hubH1}</h1>
      <p>{L.hubIntro}</p>
    </div>
  </div>
  <div class="wrap">
    {categories.map((c) => (
      <section class="block" aria-label={c}>
        <span class="eyebrow">{c}</span>
        <div class="cards">
          {guides.filter((g) => g.meta.category === c).map((g) => (
            <a class="card" href={guidePath(g.slug, lang)}><strong>{g.meta.h1}</strong>{' '}<span>{g.meta.description}</span></a>
          ))}
        </div>
      </section>
    ))}
    <p class="prose" style="margin-top:40px"><a href={localePath(lang)}>{L.backToTool}</a></p>
  </div>
</Base>
