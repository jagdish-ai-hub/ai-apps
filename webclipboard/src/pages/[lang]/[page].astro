---
// /<lang>/<page>/ pages written natively: the QR code tools (qr-code-generator, ...) and the notes tools (bloco-de-notas-online, ...).
// More specific routes such as guides/ win over this one.
import NativeQrPage from '../../components/NativeQrPage.astro';
import NativeNotesPage from '../../components/NativeNotesPage.astro';
import { qrLangs, qrKinds, QR_KINDS } from '../../lib/qrpages';
import { notesLangs, notesKinds, notesSlug } from '../../lib/notespages';

export function getStaticPaths() {
  return [
    ...qrLangs.flatMap((lang) => qrKinds.map((kind) => ({ params: { lang, page: QR_KINDS[kind] }, props: { type: 'qr', lang, kind } }))),
    ...notesLangs.flatMap((lang) => notesKinds.map((kind) => ({ params: { lang, page: notesSlug(kind, lang) }, props: { type: 'notes', lang, kind } }))),
  ];
}
const { type, lang, kind } = Astro.props;
---
{type === 'qr' ? <NativeQrPage lang={lang} kind={kind} /> : <NativeNotesPage lang={lang} kind={kind} />}
