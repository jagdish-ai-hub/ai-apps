---
import Base from '../../layouts/Base.astro';
import Tool from '../../components/Tool.astro';
import Ad from '../../components/Ad.astro';
import { guides, guidePath, findGuide } from '../../lib/guides';
import { site, absolute } from '../../lib/i18n';

export function getStaticPaths() {
  return guides.map((g) => ({ params: { slug: g.slug }, props: { slug: g.slug } }));
}
const { slug } = Astro.props;
const guide = findGuide(slug)!;
const { meta, Content, headings } = guide;
const url = absolute(guidePath(slug));
const toc = headings.filter((h) => h.depth === 2);
const showTokensCta = (meta as any).tool === 'tokens';
const related = meta.related.map(findGuide).filter(Boolean) as typeof guides;

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: meta.h1,
    description: meta.description,
    inLanguage: 'en',
    datePublished: meta.updated,
    dateModified: meta.updated,
    mainEntityOfPage: url,
    image: absolute('/og.png'),
    author: { '@type': 'Organization', name: site.siteName, url: absolute('/') },
    publisher: { '@type': 'Organization', name: site.siteName, logo: { '@type': 'ImageObject', url: absolute('/icon-512.png') } },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: absolute('/') },
      { '@type': 'ListItem', position: 2, name: 'Guides', item: absolute('/guides/') },
      { '@type': 'ListItem', position: 3, name: meta.h1, item: url },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: meta.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<Base title={meta.title} description={meta.description} page={guidePath(slug)} jsonld={jsonld} section="guides">
  <div class="hero guide-hero">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/guides/">Guides</a></nav>
      <span class="eyebrow">{meta.category}</span>
      <h1>{meta.h1}</h1>
      <p>{meta.lead}</p>
    </div>
  </div>

  <div class="wrap">
    {showTokensCta ? (
      <div class="cta">
        <p><strong>Count your own tokens</strong>Paste any text to see exactly how many tokens it uses with OpenAI's tokenizers, how it is split, and what it costs at your prices.</p>
        <a class="btn" href="/token-calculator/">Open the Token Calculator</a>
      </div>
    ) : (<Tool lang="en" />)}
    <Ad slot="afterTool" />

    <div class="guide-body">
      {toc.length > 2 && (
        <nav class="toc" aria-label="On this page">
          <span class="eyebrow">On this page</span>
          <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </nav>
      )}
      <article class="article"><Content /></article>
    </div>

    <Ad slot="inContent" />

    <section class="block faq" aria-labelledby="faq">
      <span class="eyebrow">FAQ</span>
      <h2 id="faq">Frequently asked questions</h2>
      {meta.faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
    </section>

    {related.length > 0 && (
      <section class="block" aria-labelledby="more">
        <span class="eyebrow">More guides</span>
        <h2 id="more">Related guides</h2>
        <div class="cards">
          {related.map((g) => (
            <a class="card" href={guidePath(g.slug)}>
              <span class="eyebrow">{g.meta.category}</span>
              <strong>{g.meta.h1}</strong>
              <span>{g.meta.description}</span>
            </a>
          ))}
        </div>
      </section>
    )}
    <Ad slot="beforeFooter" />
  </div>
</Base>
