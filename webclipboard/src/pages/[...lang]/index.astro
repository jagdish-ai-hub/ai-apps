---
import Base from '../../layouts/Base.astro';
import Tool from '../../components/Tool.astro';
import Ad from '../../components/Ad.astro';
import { languages, messages, fill, site, absolute, localePath } from '../../lib/i18n';
import { guidesFor, guidePath, guidesHubPath } from '../../lib/guides';
import { guideLabels } from '../../lib/guidelangs.js';
import { tools, toolPath } from '../../lib/tools';

export function getStaticPaths() {
  // English lives at "/", every other language at "/<code>/".
  return languages.map((l) => ({ params: { lang: l.code === 'en' ? undefined : l.code }, props: { code: l.code } }));
}
const { code } = Astro.props;
const m = messages(code);
const guides = guidesFor(code);
const L = guideLabels[code];
const faq = ([...(m.faq as any[]), ...((m.faqExtra as any[]) ?? [])] as { q: string; a: string }[]).map((f) => ({ q: fill(f.q), a: fill(f.a) }));
const url = absolute(localePath(code));

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: site.siteName,
    url,
    description: m.metaDescription,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    browserRequirements: 'Requires JavaScript',
    inLanguage: code,
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<Base lang={code} title={m.metaTitle} description={m.metaDescription} page="/" translated jsonld={jsonld}>
  <div class="hero">
    <div class="wrap">
      <span class="eyebrow">~/clipboard · {site.domain}</span>
      <h1>{m.h1}</h1>
      <p>{m.tagline}</p>
    </div>
  </div>

  <div class="wrap">
    <Tool lang={code} />
    <Ad slot="afterTool" lang={code} />

    <section class="block" aria-labelledby="features">
      <span class="eyebrow">01</span>
      <h2 id="features">{m.featuresTitle}</h2>
      <div class="features">
        {(m.features as { t: string; d: string }[]).map((f, i) => (
          <div class="feature"><span class="n">{String(i + 1).padStart(2, '0')}</span><h3>{f.t}</h3><p>{f.d}</p></div>
        ))}
      </div>
    </section>

    <section class="block" aria-labelledby="how">
      <span class="eyebrow">02</span>
      <h2 id="how">{m.howTitle}</h2>
      <ol class="steps">{(m.steps as string[]).map((s) => <li>{s}</li>)}</ol>
    </section>

    {code === 'en' && (
      <section class="block" aria-labelledby="tools">
        <span class="eyebrow">Tools</span>
        <h2 id="tools">More free tools</h2>
        <p class="prose" style="margin:6px 0 0">Turn the text you receive into a Word file or PDF, clean up AI answers, count words and tokens, and more. Each tool runs in your browser, so nothing is uploaded.</p>
        <div class="cards">
          {tools.filter((t) => t.group !== 'tokens' || t.slug === 'token-calculator').map((t) => (
            <a class="card" href={toolPath(t.slug)}><strong>{t.name}</strong>{' '}<span>{t.short}</span></a>
          ))}
        </div>
        <p class="prose" style="margin-top:14px"><a href="/tools/">See all tools →</a></p>
      </section>
    )}

    {guides.length > 0 && (
      <section class="block" aria-labelledby="guides">
        <span class="eyebrow">{L.nav}</span>
        <h2 id="guides">{L.popular}</h2>
        <div class="cards">
          {guides.map((g) => (
            <a class="card" href={guidePath(g.slug, code)}>
              <span class="eyebrow">{g.meta.category}</span>
              <strong>{g.meta.h1}</strong>
            </a>
          ))}
        </div>
        {code !== 'en' && <p class="prose" style="margin-top:14px"><a href={guidesHubPath(code)}>{L.nav} →</a></p>}
      </section>
    )}

    <Ad slot="inContent" lang={code} />

    <section class="block prose" aria-labelledby="about">
      <span class="eyebrow">03</span>
      <h2 id="about">{m.aboutTitle}</h2>
      {(m.aboutText as string[]).map((p) => <p>{p}</p>)}
    </section>

    <section class="block faq" aria-labelledby="faq">
      <span class="eyebrow">04</span>
      <h2 id="faq">{m.faqTitle}</h2>
      {faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
    </section>

    <Ad slot="beforeFooter" lang={code} />
  </div>
</Base>
