---
import Base from '../../layouts/Base.astro';
import { tools, toolGroups, toolPath } from '../../lib/tools';
import type { ToolGroup } from '../../lib/tools';
import { absolute } from '../../lib/i18n';

const groups = Object.keys(toolGroups) as ToolGroup[];
const jsonld = [
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: absolute('/') },
    { '@type': 'ListItem', position: 2, name: 'Tools', item: absolute('/tools/') },
  ] },
  { '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Free online text tools', url: absolute('/tools/'),
    mainEntity: { '@type': 'ItemList', itemListElement: tools.map((t, i) => ({ '@type': 'ListItem', position: i + 1, name: t.name, url: absolute(toolPath(t.slug)) })) } },
];
---
<Base title="Free Online Text Tools: Convert, Count Tokens | WebClipboard" description="Free browser-based text tools: convert text and Markdown to Word or PDF, count LLM tokens and estimate API cost. Nothing is uploaded, no sign-up needed." page="/tools/" section="tools" jsonld={jsonld}>
  <div class="hero guide-hero">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / Tools</nav>
      <span class="eyebrow">Tools</span>
      <h1>Free online text tools</h1>
      <p>Small, fast tools for working with text, built to run entirely in your browser. Convert text and Markdown to Word or PDF, or count the tokens in a prompt. No sign-up, no uploads, no watermarks.</p>
    </div>
  </div>
  <div class="wrap">
    {groups.map((g) => (
      <section class="block" aria-labelledby={`g-${g}`}>
        <span class="eyebrow">{toolGroups[g].title}</span>
        <p class="prose" style="margin:6px 0 0">{toolGroups[g].blurb}</p>
        <div class="cards">
          {tools.filter((t) => t.group === g).map((t) => (
            <a class="card" href={toolPath(t.slug)}><strong>{t.name}</strong>{' '}<span>{t.short}</span></a>
          ))}
        </div>
      </section>
    ))}
    <section class="block prose">
      <span class="eyebrow">Also on this site</span>
      <h2>Move text between devices</h2>
      <p>The <a href="/">online clipboard</a> lets you paste text on one device and open it on another with a 6-digit code, a short link or a QR code. Whatever you receive can be saved as a .txt, .md, Word or PDF file straight from the clipboard.</p>
      <p>New to it? The <a href="/guides/">guides</a> explain how to send text from a phone to a PC, share a Wi-Fi password, move notes for school and more.</p>
    </section>
  </div>
</Base>
